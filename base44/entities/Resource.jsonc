{
  "name": "Resource",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "uniforms",
        "policies",
        "travel",
        "handbook",
        "forms",
        "coaches",
        "general"
      ],
      "enumColors": [
        "blue",
        "red",
        "purple",
        "green",
        "yellow",
        "pink",
        "gray"
      ],
      "default": "general"
    },
    "file_url": {
      "type": "string",
      "description": "Uploaded document URL"
    },
    "link_url": {
      "type": "string",
      "description": "External link instead of a file"
    },
    "team": {
      "type": "string",
      "description": "Team record id; leave empty for all teams"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "coaches"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "default": "public"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {}
  }
}