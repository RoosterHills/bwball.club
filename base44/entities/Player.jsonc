{
  "name": "Player",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Player name"
    },
    "team": {
      "type": "string",
      "description": "Team record id"
    },
    "jersey_number": {
      "type": "string"
    },
    "positions": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "guardian_emails": {
      "type": "string",
      "description": "Comma-separated parent / guardian emails approved to see this player"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes \u2014 visible to approved members only"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.access_status": "approved"
              }
            },
            {
              "data.team": {
                "$in": "{{user.data.linked_teams}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}