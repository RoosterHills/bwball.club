{
  "name": "Partner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Partner organization, e.g. SUBPAR"
    },
    "role_label": {
      "type": "string",
      "description": "Public role, e.g. Official Merchandise Partner"
    },
    "partner_type": {
      "type": "string",
      "enum": [
        "merchandise",
        "scoring",
        "technology",
        "service",
        "community"
      ],
      "enumColors": [
        "purple",
        "blue",
        "gray",
        "green",
        "yellow"
      ],
      "default": "service"
    },
    "logo": {
      "type": "string",
      "description": "Partner logo image URL"
    },
    "website": {
      "type": "string"
    },
    "blurb": {
      "type": "string",
      "description": "One-line description of what the partner provides"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {}
  }
}