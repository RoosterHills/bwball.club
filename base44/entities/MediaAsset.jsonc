{
  "name": "MediaAsset",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "description": "Uploaded image URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "team_photo",
        "sponsor_asset",
        "banner",
        "gallery",
        "general"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "green",
        "gray"
      ],
      "default": "general"
    },
    "privacy": {
      "type": "string",
      "description": "public = anyone, members = approved accounts, team = linked team members, admin = staff only",
      "enum": [
        "public",
        "members",
        "team",
        "admin"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "red"
      ],
      "default": "public"
    },
    "gallery": {
      "type": "string",
      "description": "Gallery name, e.g. 16U Summer 2027"
    },
    "team": {
      "type": "string",
      "description": "Team record id"
    },
    "season": {
      "type": "string",
      "description": "Season record id"
    },
    "caption": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.privacy": "public"
        },
        {
          "data.privacy": {
            "$exists": false
          }
        },
        {
          "$and": [
            {
              "data.privacy": "members"
            },
            {
              "user_condition": {
                "data.access_status": "approved"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.privacy": "team"
            },
            {
              "user_condition": {
                "data.access_status": "approved"
              }
            },
            {
              "data.team": {
                "$in": "{{user.data.linked_teams}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}