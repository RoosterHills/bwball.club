{
  "name": "MediaAsset",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "description": "Uploaded image URL"
    },
    "category": {
      "type": "string",
      "enum": [
        "team_photo",
        "sponsor_asset",
        "banner",
        "gallery",
        "general"
      ],
      "enumColors": [
        "blue",
        "yellow",
        "purple",
        "green",
        "gray"
      ],
      "default": "general"
    },
    "gallery": {
      "type": "string",
      "description": "Gallery name, e.g. 16U Summer 2027"
    },
    "team": {
      "type": "string",
      "description": "Team record id"
    },
    "season": {
      "type": "string",
      "description": "Season record id"
    },
    "caption": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "archived": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {}
  }
}