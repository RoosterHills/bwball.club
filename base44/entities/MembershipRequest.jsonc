{
  "name": "MembershipRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "requested_level": {
      "type": "string",
      "enum": [
        "fan",
        "parent",
        "player",
        "coach",
        "team_admin"
      ],
      "enumColors": [
        "blue",
        "green",
        "purple",
        "yellow",
        "pink"
      ],
      "default": "parent"
    },
    "players": {
      "type": "string",
      "description": "Names of the players this person is linked to"
    },
    "team": {
      "type": "string",
      "description": "Team record id they belong to"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "denied"
      ],
      "enumColors": [
        "yellow",
        "green",
        "red"
      ],
      "default": "pending"
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}