{
  "name": "Sport",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "e.g. Baseball, Basketball"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe key, e.g. baseball"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {}
  }
}