{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Team nickname, e.g. Eagles"
    },
    "slug": {
      "type": "string",
      "description": "Public URL, e.g. 16u renders at /16u"
    },
    "age_group": {
      "type": "string",
      "description": "e.g. 13U, 16U"
    },
    "sport": {
      "type": "string",
      "description": "Sport record id"
    },
    "season": {
      "type": "string",
      "description": "Season label, e.g. Spring 2027"
    },
    "season_ref": {
      "type": "string",
      "description": "Season record id"
    },
    "brand": {
      "type": "string",
      "description": "TeamBrand record id \u2014 drives logo and colors"
    },
    "division": {
      "type": "string",
      "description": "Optional division or league"
    },
    "motto": {
      "type": "string",
      "description": "Team motto shown on the hub, e.g. One Team. One Standard."
    },
    "description": {
      "type": "string",
      "description": "Short team blurb shown under the hub header"
    },
    "brand_story": {
      "type": "string",
      "description": "Longer brand story shown on the team hub"
    },
    "head_coach": {
      "type": "string"
    },
    "head_coach_email": {
      "type": "string"
    },
    "assistant_coaches": {
      "type": "string"
    },
    "photo": {
      "type": "string",
      "description": "Team photo URL"
    },
    "wins": {
      "type": "number",
      "default": 0
    },
    "losses": {
      "type": "number",
      "default": 0
    },
    "ties": {
      "type": "number",
      "default": 0
    },
    "gamechanger_url": {
      "type": "string"
    },
    "schedule_url": {
      "type": "string"
    },
    "watch_live_url": {
      "type": "string"
    },
    "stats_url": {
      "type": "string"
    },
    "roster_url": {
      "type": "string"
    },
    "photos_url": {
      "type": "string"
    },
    "store_url": {
      "type": "string"
    },
    "store_label": {
      "type": "string",
      "description": "Label for the team store link, e.g. Eagles Team Store"
    },
    "sponsor": {
      "type": "string",
      "description": "Sponsor record id \u2014 drives the team display name"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Hidden from the public site but kept for history"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {}
  }
}