{
  "name": "Story",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "community_impact",
        "alumni_spotlight",
        "championship",
        "award",
        "team_history",
        "fundraiser"
      ],
      "enumColors": [
        "green",
        "blue",
        "yellow",
        "purple",
        "gray",
        "pink"
      ],
      "default": "community_impact"
    },
    "summary": {
      "type": "string",
      "description": "One-line teaser shown on cards"
    },
    "body": {
      "type": "string",
      "description": "The full story"
    },
    "image": {
      "type": "string",
      "description": "Photo for this story"
    },
    "person": {
      "type": "string",
      "description": "Alumni name or person being highlighted"
    },
    "grad_year": {
      "type": "string",
      "description": "Alumni graduation year, e.g. 2019"
    },
    "team": {
      "type": "string",
      "description": "Team record id, optional"
    },
    "story_date": {
      "type": "string",
      "description": "Date the story happened"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "published": {
      "type": "boolean",
      "default": true,
      "description": "Visible on the public site"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.published": true
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}