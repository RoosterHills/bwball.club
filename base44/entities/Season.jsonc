{
  "name": "Season",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "e.g. Spring 2027"
    },
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "active",
        "complete"
      ],
      "enumColors": [
        "blue",
        "green",
        "gray"
      ],
      "default": "upcoming"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {}
  }
}