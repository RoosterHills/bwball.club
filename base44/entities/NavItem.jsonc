{
  "name": "NavItem",
  "type": "object",
  "properties": {
    "label": {
      "type": "string"
    },
    "href": {
      "type": "string",
      "description": "Site path such as /schedule, or a full URL"
    },
    "group": {
      "type": "string",
      "enum": [
        "header",
        "footer"
      ],
      "enumColors": [
        "blue",
        "gray"
      ],
      "default": "header"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "visible": {
      "type": "boolean",
      "default": true
    },
    "external": {
      "type": "boolean",
      "default": false,
      "description": "Opens a full URL in a new tab"
    }
  },
  "required": [
    "label",
    "href"
  ],
  "rls": {
    "read": {}
  }
}